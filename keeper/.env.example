# Template only — the keeper reads the environment directly (no dotenv).
# Export vars per command, or: set -a; source .env; set +a
# Never commit real secrets.
RPC_URL=https://api.devnet.solana.com
OPERATOR_KEYPAIR=~/.config/solana/harbor-operator.json
# Unset = dry-run (logs intent, sends nothing). Production: live.
MODE=
POLL_MS=30000
LOG_PATH=keeper.log.jsonl
RUN_ONCE=
UPSTREAM_PROGRAM_ALLOWLIST=CHNLxYvVA28MJP9PrFuDXccuoGXAx7jBacfLEkahyGsX
HARBOR_PROGRAM_ID=BuRyKLqCsTLcyLVFEjxTjmF4DryCT3LmVDjwqhduvB4H
