# server .env template — copy to .env (auto-loaded from CWD; exported vars win).
# Never commit real secrets.
PORT=3000
RPC_URL=https://api.devnet.solana.com
MERCHANT_KEYPAIR=~/.config/solana/id.json
MINT=HDwpthFfTBi4YyGo1zgd7zxyonE5CZsCizpVqURHGD54
PRICE_PER_TOKEN=10
# Empty = kill switch open (local rehearsal only). Production: random hex.
KILL_TOKEN=
# Receipt lifetime in slots (default: effectively never). Set low with a
# scratch merchant to exercise the onchain Expired path.
RECEIPT_EXPIRY_SLOTS=
UPSTREAM_PROGRAM_ALLOWLIST=CHNLxYvVA28MJP9PrFuDXccuoGXAx7jBacfLEkahyGsX
# Empty = in-memory store. Production: a persistent path.
STORE_PATH=
